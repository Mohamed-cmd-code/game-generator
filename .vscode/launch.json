{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (uvicorn --reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "envFile": "${workspaceFolder}/.env",
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Run demo prompts (Groq)",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.run_demos",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Evaluate retrieval",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.eval_retrieval",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Tests (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"]
    }
  ]
}
